% Visible draft placeholders; remove only when the corresponding result is validated.
\newcommand{\todo}[1]{\textcolor{red!70!black}{\textbf{[TODO: #1]}}}

% Figure with a labelled placeholder box when the asset is not yet available.
% #1 = path (with extension), #2 = width, #3 = placeholder height.
\newcommand{\includegraphicsorbox}[3]{%
  \IfFileExists{#1}{\includegraphics[width=#2]{#1}}{%
    \fbox{\parbox[c][#3][c]{\dimexpr#2-2\fboxsep-2\fboxrule\relax}{\centering\small\textbf{Placeholder:} figure asset \detokenize{#1} not yet available.}}}}
